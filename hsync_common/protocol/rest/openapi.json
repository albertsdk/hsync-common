              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Get bucket information",
        "tags": [
          "Authenticated Router"
        ]
      }
    },
    "/api/v1/buckets/{bucket}/files": {
      "delete": {
        "description": "Delete a file from a bucket.\n\nRemoves the file and broadcasts a \"deleted\" event to all\nconnected WebSocket clients.\n\nArgs:\n    bucket: Name of the bucket containing the file.\n    cid: Client ID for event broadcasting.\n    filename: Path to the file within the bucket.\n\nReturns:\n    JSON response confirming deletion.\n\nRaises:\n    InvalidBucketNameError: If bucket name is invalid.\n    BucketNotFoundError: If bucket does not exist.\n    InvalidPathError: If path is invalid.\n    HSyncFileNotFoundError: If file does not exist.\n    DeleteError: If deletion fails.",
        "operationId": "delete_file_api_v1_buckets__bucket__files_delete",
        "parameters": [
          {
            "in": "path",
            "name": "bucket",
            "required": true,
            "schema": {
              "title": "Bucket",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/Body_delete_file_api_v1_buckets__bucket__files_delete"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Delete File",
        "tags": [
          "Authenticated Router"
        ]
      },
      "get": {
        "description": "List all files in a bucket or subdirectory.\n\nRecursively walks the directory tree and returns metadata for\nall non-hidden files, sorted by mtime ascending (oldest first)\nto prioritize updating older files.\n\nArgs:\n    bucket: Name of the bucket to list files from.\n    path: Optional subdirectory path within the bucket.\n\nReturns:\n    JSON response with list of file metadata dictionaries.\n\nRaises:\n    InvalidBucketNameError: If bucket name is invalid.\n    InvalidPathError: If path is invalid.\n    BucketNotFoundError: If bucket does not exist.",
        "operationId": "get_files_api_v1_buckets__bucket__files_get",
        "parameters": [
          {
            "in": "path",
            "name": "bucket",
            "required": true,
            "schema": {
              "title": "Bucket",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "path",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Path"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Get Files",
        "tags": [
          "Authenticated Router"
        ]
      },
      "post": {
        "description": "Upload a file to a bucket with resumable upload support.\n\nHandles file upload with integrity verification (SHA-256), timestamp\npreservation, and permission setting. Broadcasts an \"added\" event\nto all connected WebSocket clients.\n\nSupports resumable uploads: if offset > 0, the incoming data is\nappended to an existing partial file (.part extension).\n\nArgs:\n    bucket: Target bucket name.\n    cid: Client ID for event broadcasting.\n    file: The file to upload.\n    path: Subdirectory path within the bucket.\n    ctime: Creation time (Unix timestamp or ISO string).\n    mtime: Modification time (Unix timestamp or ISO string).\n    sha256sum: Expected SHA-256 checksum for integrity verification.\n    permissions: File permissions as an octal string (e.g., '644').\n    offset: Byte offset for resumable uploads (0 for new uploads).\n    size: Total file size (required for resumable uploads).\n\nReturns:\n    JSON response confirming upload or conflict if identical file exists.\n\nRaises:\n    InvalidBucketNameError: If bucket name is invalid.\n    InvalidPathError: If path is invalid.\n    InvalidPermissionFormatError: If permission format is invalid.\n    InvalidFilenameError: If filename contains forbidden characters or is reserved.\n    ChecksumMismatchError: If SHA-256 checksum verification fails.\n    UploadError: If upload operation fails.",
        "operationId": "upload_file_api_v1_buckets__bucket__files_post",
        "parameters": [
          {
            "in": "path",
            "name": "bucket",
            "required": true,
            "schema": {
              "title": "Bucket",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_file_api_v1_buckets__bucket__files_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Upload File",
        "tags": [
          "Authenticated Router"
        ]
      }
    },
    "/api/v1/buckets/{bucket}/files/download": {
      "get": {
        "description": "Download a file from a bucket with optional zstd compression.\n\nStreams the file content as a response with appropriate headers.\nIf compression is enabled and beneficial, compresses the file before sending.\n\nArgs:\n    request: The incoming FastAPI request.\n    bucket: Name of the bucket containing the file.\n    filename: Path to the file within the bucket.\n\nReturns:\n    FileResponse or Response with the file content for download.\n\nRaises:\n    InvalidBucketNameError: If bucket name is invalid.\n    InvalidPathError: If path is invalid.\n    HSyncFileNotFoundError: If file does not exist.",
        "operationId": "download_file_api_v1_buckets__bucket__files_download_get",
        "parameters": [
          {
            "in": "path",
            "name": "bucket",
            "required": true,
            "schema": {
              "title": "Bucket",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "filename",
            "required": true,
            "schema": {
              "title": "Filename",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Download File",
        "tags": [
          "Authenticated Router"
        ]
      }
    },
    "/api/v1/buckets/{bucket}/files/upload-status": {
      "get": {
        "description": "Get upload status for resumable uploads.\n\nChecks if a partial file exists from a previous interrupted upload\nand returns the current offset from which the client can resume.\n\nArgs:\n    request: The incoming FastAPI request.\n    bucket: Target bucket name.\n    filename: Path to the file within the bucket.\n    sha256sum: Expected SHA-256 checksum of the complete file.\n    size: Expected size of the complete file.\n\nReturns:\n    JSON response with upload status:\n    - offset: Number of bytes already uploaded (0 if no partial file)\n    - status: \"resumable\" if partial file exists, \"new\" otherwise\n\nRaises:\n    InvalidBucketNameError: If bucket name is invalid.\n    InvalidPathError: If path is invalid.",
        "operationId": "get_upload_status_api_v1_buckets__bucket__files_upload_status_get",
        "parameters": [
          {
            "in": "path",
            "name": "bucket",
            "required": true,
            "schema": {
              "title": "Bucket",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "filename",
            "required": true,
            "schema": {
              "title": "Filename",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "sha256sum",
            "required": false,
            "schema": {
              "default": "",
              "title": "Sha256Sum",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "size",
            "required": false,
            "schema": {
              "default": 0,
              "title": "Size",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Get Upload Status",
        "tags": [
          "Authenticated Router"
        ]
      }
    },
    "/api/v1/buckets/{bucket}/tombstones": {
      "get": {
        "description": "List deletion markers (tombstones) for a bucket.\n\nReturns a mapping of hashed bucket-relative path to the deletion\ntimestamp and the content hash of the removed file. Clients use these\nmarkers to avoid resurrecting files that were deleted while they were\noffline.\n\nArgs:\n    request: The incoming FastAPI request.\n    bucket: Name of the bucket to list tombstones from.\n\nReturns:\n    JSON response with the tombstone payload.\n\nRaises:\n    InvalidBucketNameError: If bucket name is invalid.\n    BucketNotFoundError: If bucket does not exist.",
        "operationId": "get_tombstones_api_v1_buckets__bucket__tombstones_get",
        "parameters": [
          {
            "in": "path",
            "name": "bucket",
            "required": true,
            "schema": {
              "title": "Bucket",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Get Tombstones",
        "tags": [
          "Authenticated Router"
        ]
      }
    },
    "/api/v1/time": {
      "get": {
        "description": "Return the server's current timestamp for clock synchronization.\n\nClients use this endpoint to calculate clock offset via round-trip\nmeasurement (NTP-like): the client records T1 before the request,\nthe server returns T2, and the client records T3 after the response.\nOffset = T2 - (T1 + RTT/2), where RTT = T3 - T1.\n\nReturns:\n    JSON with ``{\"timestamp\": <float>}`` (Unix epoch seconds).",
        "operationId": "Clock_synchronization_endpoint_api_v1_time_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Clock Synchronization Endpoint",
        "tags": [
          "Public Router"
        ]
      }
    },
