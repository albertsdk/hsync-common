  "info": {
    "title": "HSYNC - HTTP Sync file server",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/buckets": {
      "post": {
        "description": "Create a new storage bucket.\n\nCreates a directory in the buckets storage area with the specified name.\nBucket names must be alphanumeric (hyphens and underscores allowed,\nbut not at the beginning or end).\n\nArgs:\n    bucket: Name for the new bucket.\n\nReturns:\n    JSON response confirming creation or conflict if exists.\n\nRaises:\n    InvalidBucketNameError: If bucket name is invalid.",
        "operationId": "create_bucket_api_v1_buckets_post",
        "parameters": [
          {
            "in": "query",
            "name": "bucket",
            "required": true,
            "schema": {
              "title": "Bucket",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Create Bucket",
        "tags": [
          "Authenticated Router"
        ]
      }
    },
    "/api/v1/buckets/{bucket}": {
      "delete": {
        "description": "Delete a bucket and all its contents.\n\nPermanently removes the bucket directory and all files/subdirectories.\nThis operation cannot be undone.\n\nArgs:\n    bucket: Name of the bucket to delete.\n\nReturns:\n    JSON response confirming deletion.\n\nRaises:\n    InvalidBucketNameError: If bucket name is invalid.\n    BucketNotFoundError: If bucket does not exist.\n    DeleteError: If deletion fails.",
        "operationId": "delete_bucket_api_v1_buckets__bucket__delete",
        "parameters": [
          {
            "in": "path",
            "name": "bucket",
            "required": true,
            "schema": {
              "title": "Bucket",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Delete Bucket",
        "tags": [
          "Authenticated Router"
        ]
      },
      "get": {
        "description": "Get bucket information including timestamps.",
        "operationId": "Get_bucket_information_api_v1_buckets__bucket__get",
        "parameters": [
          {
            "in": "path",
            "name": "bucket",
            "required": true,
            "schema": {
              "title": "Bucket",
              "type": "string"
            }
          }
        ],
        "responses": {
